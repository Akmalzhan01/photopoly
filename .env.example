# Copy to `.env` and fill in. Never commit the filled-in file.
#
# --- What Vercel needs ------------------------------------------------------
# Project -> Settings -> Environment Variables. Paste values without quotes;
# Vercel stores the literal text, so a wrapping " ends up inside the value.
#
#   Required        DATABASE_URL, DIRECT_URL, SESSION_SECRET, APP_URL
#   Uploaded suits  SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   Online payment  FINIK_API_KEY, FINIK_ACCOUNT_ID,
#                   FINIK_PRIVATE_KEY, FINIK_PUBLIC_KEY, FINIK_ENV
#
# Leaving every FINIK_* unset is a supported way to run, not a broken one: the
# purchase flow is identical until the last step, where the order is recorded
# for an admin to confirm by hand. Tell customers where to send the money in
# Admin -> Overview -> "Как оплатить" — that text appears on the order page,
# and until it is filled in the page just says to contact the administrator.
#
# Do NOT set on Vercel:
#   SHADOW_DATABASE_URL   only `prisma migrate dev` uses it, locally
#   SEED_ADMIN_EMAIL      read only by `npm run db:seed`, which you run from
#   SEED_ADMIN_PASSWORD   your own machine — an admin password sitting in the
#                         production environment buys nothing and is one more
#                         place it can leak from
#
# APP_URL must be the real origin (https://…), not a preview URL: Finik builds
# its redirect and webhook callbacks from it, so a wrong value means payments
# come back to the wrong place — or nowhere.

# --- Database -------------------------------------------------------------
# Development: run `npm run db` and paste the connection string it prints.
# Production: any PostgreSQL (Supabase, Neon, your own server).
DATABASE_URL=""
# Only needed for `prisma migrate dev`, not at runtime.
SHADOW_DATABASE_URL=""

# Used by `prisma migrate` only. Leave empty locally.
DIRECT_URL=""

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Connect. Take the two "Session pooler" / "Transaction pooler"
# strings, NOT "Direct connection": db.<ref>.supabase.co resolves to an IPv6
# address only, so it is unreachable from most home networks and from Vercel.
#
#   DATABASE_URL  -> Transaction pooler, port 6543   (the app)
#   DIRECT_URL    -> Session pooler,     port 5432   (migrations)
#
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
#   DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Copy the host exactly — it is aws-0-… for some projects and aws-1-… for
# others. Replace <password> with the database password (Settings -> Database
# -> Reset database password if you no longer have it), and percent-encode any
# @ : / ? # or & it contains.
#
# A trailing `?sslmode=require` is safe to leave on: the app strips it and
# verifies against Supabase's own root certificate instead, which is stronger.
# `SHADOW_DATABASE_URL` stays empty — production uses `npm run db:deploy`,
# which needs no shadow database.

# --- Supabase Storage (uploaded suits) -------------------------------------
# Only needed for the suits admin page. Left empty, the studio simply shows no
# clothing section at all and the admin page explains what is missing.
#
#   1. Dashboard -> Storage -> New bucket, name it exactly `kostyum`,
#      and tick "Public bucket" — the browser fetches the PNG directly.
#   2. Dashboard -> Settings -> API keys, copy the `service_role` key.
#
# The service_role key bypasses every row-level security rule. It is read only
# on the server, never sent to the browser, and must never be committed.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- Sessions -------------------------------------------------------------
# Signs the session cookie:  openssl rand -base64 32
# Changing it logs everybody out, which is what you want after a leak.
SESSION_SECRET=""

# --- Finik ----------------------------------------------------------------
# Leave FINIK_API_KEY empty and the app records orders in MANUAL mode instead,
# for an admin to confirm by hand. Everything else behaves identically, so the
# purchase flow is usable before the merchant account exists.
#
# Setup, per https://www.finik.kg/en/documentation/web-sdk/ :
#   1. openssl genrsa -out finik_private.pem 2048
#   2. openssl rsa -in finik_private.pem -pubout -out finik_public.pem
#   3. Upload finik_public.pem in the Finik dashboard under "Keys",
#      client type "Web client". Copy the API key it gives you.
FINIK_API_KEY=""

# Data.accountId from the Finik dashboard.
FINIK_ACCOUNT_ID=""

# Your private key, base64-encoded so it fits on one line:
#   node -e "console.log(require('fs').readFileSync('finik_private.pem','base64'))"
FINIK_PRIVATE_KEY=""

# Finik's public key, same encoding. Without it the webhook endpoint refuses
# every request, so payments never activate on their own. Take it from
# https://www.finik.kg/en/documentation/web-sdk/reference/ — it differs
# between beta and production.
FINIK_PUBLIC_KEY=""

# "beta" or "production".
FINIK_ENV="beta"

# --- App ------------------------------------------------------------------
# Public origin. Used to build the redirect and webhook URLs sent to Finik, so
# it must be reachable from the internet — in development use a tunnel
# (ngrok, cloudflared) rather than localhost, or webhooks will never arrive.
APP_URL="http://localhost:3000"

# --- First superadmin (read only by `npm run db:seed`) --------------------
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
